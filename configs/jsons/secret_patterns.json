[
  {"name": "private_key", "pattern": "(?s)-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----.*?(?:-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----|\\z)"},
  {"name": "private_key_tail", "pattern": "(?m)(?:^[A-Za-z0-9+/=]+[ \\t\\r]*\\n)+-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----"},
  {"name": "url_credential", "pattern": "[A-Za-z][A-Za-z0-9+.-]*://[^/\\s:@]+:(?P<secret>[^/\\s@]+)@"},
  {"name": "bearer", "pattern": "(?i)\\b(?:bearer|basic|token)\\s+(?P<secret>[A-Za-z0-9._~+/-]{16,}=*)", "require_digit": true},
  {"name": "netrc_password", "pattern": "(?i)\\b(?:password|passwd)\\s+(?P<secret>\\S{6,})", "require_digit": true},
  {"name": "aws_access_key", "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"},
  {"name": "github_token", "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})\\b"},
  {"name": "gitlab_token", "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}\\b"},
  {"name": "llm_api_key", "pattern": "\\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}\\b"},
  {"name": "xai_api_key", "pattern": "\\bxai-[A-Za-z0-9]{20,}\\b"},
  {"name": "slack_token", "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,}\\b"},
  {"name": "google_api_key", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b"},
  {"name": "google_oauth_token", "pattern": "\\bya29\\.[0-9A-Za-z_-]{20,}\\b"},
  {"name": "stripe_key", "pattern": "\\b[rs]k_(?:live|test)_[0-9A-Za-z]{16,}\\b"},
  {"name": "npm_token", "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b"},
  {"name": "huggingface_token", "pattern": "\\bhf_[A-Za-z0-9]{30,}\\b"},
  {"name": "telegram_bot_token", "pattern": "\\b[0-9]{8,10}:AA[0-9A-Za-z_-]{30,}\\b"},
  {"name": "jwt", "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"},
  {"name": "docker_auth", "pattern": "(?i)\"auth\"\\s*:\\s*\"(?P<secret>[^\"]{8,})\""},
  {"name": "key_value", "pattern": "(?i)[A-Z0-9_.-]*(?:secret|token|passw(?:or)?d|pwd|api[_-]?key|access[_-]?key|private[_-]?key|credential)s?[A-Z0-9_.-]*[\"']?\\s*[:=]\\s*[\"']?(?P<secret>[A-Za-z0-9_\\-./+=~@!$%^&*]{8,})", "skip_call": true, "require_digit": true},
  {"name": "base64_line", "pattern": "(?m)^[A-Za-z0-9+/]{60,100}={0,2}\\s*$", "skip_hex": true}
]
